{
  "name": "noof-dental-clinic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:vapid": "node scripts/generate-vapid.js",
    "android:icons": "node scripts/copy-android-assets.js",
    "android:sync": "npx cap sync android",
    "android:copy": "npx cap copy android",
    "android:open": "npx cap open android",
    "android:clean": "cd android && gradlew clean",
    "android:keystore": "powershell -ExecutionPolicy Bypass -File scripts/generate-keystore.ps1",
    "android:build": "npm run build && npm run android:icons && set CAPACITOR_ENV=development && npx cap sync android",
    "android:release:apk": "set CAPACITOR_ENV=production && npm run build && npm run android:icons && npx cap sync android && cd android && gradlew assembleRelease",
    "android:release:aab": "set CAPACITOR_ENV=production && npm run build && npm run android:icons && npx cap sync android && cd android && gradlew bundleRelease",
    "android:dev": "set CAPACITOR_ENV=development && npm run build && npm run android:icons && npx cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "dexie": "^3.2.4",
    "lucide-react": "^0.312.0",
    "next": "14.1.0",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^1.3.1",
    "tailwind-merge": "^2.2.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
