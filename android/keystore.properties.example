# إعدادات توقيع تطبيق مركز نوف لأندرويد (Play Store Release)
#
# طريقة الاستخدام:
# 1. شغّل أولاً سكربت: scripts/generate-keystore.ps1
#    أو أنشئ keystore يدوياً عبر:
#    keytool -genkey -v -keystore noof-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias noofapp
# 2. ضع ملف noof-release-key.jks في مجلد android/app/
# 3. عدّل القيم الأدنى وفقاً لما اخترته عند توليد المفتاح:

STORE_FILE=../noof-release-key.jks
STORE_PASSWORD=NoofDentalClinic2026!
KEY_ALIAS=noofapp
KEY_PASSWORD=NoofDentalClinic2026!
